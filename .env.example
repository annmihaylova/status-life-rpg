# Скопируй в .env.local и заполни. .env.local в git не попадает.

# Supabase: Project Settings → API (локально — вывод `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Адрес сайта (на Vercel — продовый домен)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Показывать кнопку «Войти через Google» (true, когда провайдер включён в Supabase)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Поле «код из письма» (true, если шаблон письма содержит {{ .Token }}: локально да,
# в облаке — только после настройки своего SMTP в Supabase)
NEXT_PUBLIC_AUTH_EMAIL_CODE=false

# Только сервер. Postgres-строка подключения (на проде — Supabase pooler, transaction mode, порт 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google OAuth для локального Supabase (supabase/config.jsonc → auth.external.google).
# На проде задаётся в панели Supabase: Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Появятся в следующих фазах:
# ANTHROPIC_API_KEY=          (фаза 1c, чек-ин)
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=   (фаза 3, push)
# RESEND_API_KEY=             (фаза 3, email)
