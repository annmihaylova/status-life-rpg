{
  "name": "status-life-rpg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "balance": "python scripts/balance.py",
    "test:db": "vitest run -c vitest.db.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "game:recompute": "tsx scripts/game-recompute.ts",
    "test:llm": "vitest run -c vitest.llm.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.16.2",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.23.0"
}
